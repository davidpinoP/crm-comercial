# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.

# URL del proyecto, p. ej. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública «anon». Es segura en el navegador porque todas las tablas
# están protegidas con Row Level Security. NO uses aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON

# Opcional: URL pública de la app (para los enlaces de confirmación de correo)
# NEXT_PUBLIC_SITE_URL=https://crm.tudominio.es
